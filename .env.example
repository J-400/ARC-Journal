# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings -> Environment Variables instead
# of committing real values.

# Password required to sign in to /admin. Change this before real use.
ADMIN_PASSWORD=arc2026

# Random string used to sign admin session cookies. Generate a strong,
# unique value for production, e.g. with: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-long-random-string

# --- Content storage --------------------------------------------------
# ARC Journal stores articles and THETA editions through lib/store.js.
# Locally (no KV vars set) it falls back to reading/writing the JSON
# files in /data, which works for development but NOT in production:
# Vercel's serverless functions run on a read-only, ephemeral
# filesystem, so admin edits will not persist between requests once
# deployed.
#
# For production, connect a Vercel KV (Redis) store to this project
# from the Vercel dashboard (Storage -> Create Database -> KV). Vercel
# will inject the variables below automatically when you link it - you
# do not need to set them by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
